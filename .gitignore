# OS noise
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Rust
/target
**/*.rs.bk

# Node (schema-ci installs @redocly/cli fresh into this on every run; never vendor it)
node_modules/

# Runtime data (embedded SQLite lives here)
/data
*.db
*.db-shm
*.db-wal

# Env
.env
.env.local

# Push credentials. These are downloaded as files from Firebase and Apple, land
# in whatever directory the browser chose, and are unrecoverable once leaked -
# an APNs key signs pushes for every app under the team. They belong on the
# server host as secrets, never in the tree.
*.p8
*.p12
*.mobileprovision
**/service-account*.json
**/firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
/secrets/

# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Flutter build output
client/**/build/
client/**/.dart_tool/

# Flutter generates these per-machine; never commit them.
client/**/linux/flutter/ephemeral/
client/**/windows/flutter/ephemeral/
client/**/macos/Flutter/ephemeral/

# A working list for the owner, not project documentation. Durable decisions
# belong in CLAUDE.md or a decision record.
human-todos.md

# Work parked out of a release, held as an appliable patch rather than as
# source that compiles nowhere. Same reasoning as human-todos.md above.
*.parked.patch
ios-broadcast-extension.patch

# Fetched by tool/fetch_web_assets.sh, pinned to pubspec.lock and digest-checked.
# The web build is a test surface, so these are not vendored into git.
client/packages/app/web/drift_worker.js
client/packages/app/web/sqlite3.wasm

# Rendered by scripts/ui-snapshots.sh for looking at, never committed.
client/packages/app/build/ui-snapshots/

# Agent worktrees, created by the Agent tool under isolation: worktree.
.claude/worktrees/
# Job-file instances handed to subagents; the template is docs/agents/job-template.md.
.claude/jobs/
# Per-machine agent state; anything else under .claude/ (agents, settings.json) may be committed.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/sources/
# Python wheels downloaded into the repo root while setting up a local tool.
/*.whl
__pycache__/

# design-sync (claude.ai/design) staging and output
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
design/web/dist/
perf/load/results/

# The server data key (see docs/OPERATING.md); never commit it
slimm-data.key

# Generated by go generate in packaging/windows/launcher
*.syso
