# slim-m server configuration (SLIMM_-prefixed environment variables).
# Copy to .env for local development.
#
# This file is for the server binary run directly (cargo run). The compose
# deployment reads deploy/.env.example instead, and passes only some of these
# through; see docs/OPERATING.md.

# TCP port for the HTTP and WebSocket surface.
SLIMM_PORT=8080

# Path to the embedded SQLite database file.
SLIMM_DATABASE_PATH=data/slimm.db

# Directory attachment and avatar bytes are stored under, beside the database
# rather than in it. NOT covered by the Litestream backup example in
# deploy/ - that streams only the SQLite file. See deploy/README.md.
SLIMM_ATTACHMENTS_DIR=data/media

# Largest attachment a single upload may store, in bytes. Default 1 GiB.
# The server streams an upload to disk as it arrives rather than buffering it,
# so a high ceiling costs disk, not memory. Total storage is bounded separately
# by SLIMM_MAX_TOTAL_ATTACHMENT_BYTES if you set it.
SLIMM_ATTACHMENT_MAX_BYTES=1073741824

# Log filter (tracing EnvFilter syntax), for example: info, debug, slimm_server=debug.
SLIMM_LOG=info

# Third-party GIF search provider this deployment proxies to: "tenor" or
# "klipy", case-insensitively. Both this and SLIMM_GIF_API_KEY must be set
# together - either left unset (or empty) means no GIF search at all, a fully
# supported way to run this. The proxy keeps a member's own IP address and
# search terms away from the provider; see crates/slimm-server/src/http/gifs.rs.
SLIMM_GIF_PROVIDER=
# API key for whichever provider SLIMM_GIF_PROVIDER names.
SLIMM_GIF_API_KEY=PLACEHOLDER

# Unfurl pasted links into title/description/image preview cards. Off by
# default: turning it on makes the server issue outbound requests to arbitrary,
# member-supplied URLs, each behind an SSRF guard that refuses private, loopback,
# link-local and metadata addresses. See docs/decisions/0019. Set to true to
# enable; anything else (or unset) leaves link previews off.
SLIMM_LINK_PREVIEWS=false

# The oldest client version this deployment will keep serving, as X.Y.Z.
# Unset, the default, means no floor: the wire is additive, so an old client
# keeps working across a server upgrade. Set it only when an old client
# genuinely cannot - it stops those clients outright and offers them an
# update instead. See docs/decisions/0025-update-strategy.md.
SLIMM_MIN_CLIENT_VERSION=

# Addresses where native clients on your own network can reach this server's
# TLS endpoint directly, as host:port, comma separated, for example
# 10.0.0.100:443. Useful behind Cloudflare or another proxy that caps upload
# speed: at home the app goes straight to the server. Clients still check the
# certificate against the public hostname, so the reverse proxy on that
# address must serve it. Advertised publicly in /version; empty means none.
SLIMM_DIRECT_ADDRESSES=

# IPs or CIDRs, comma separated, that a module holding the Private network
# approval may never reach, for example 10.0.0.50,192.168.1.0/24. This server,
# the hosts above and docker bridge networks are always refused already.
SLIMM_MODULE_LAN_DENY=

# Browser origins allowed to call this server cross-origin, comma separated.
# Empty means no CORS layer at all and every cross-origin browser request is
# refused, which is the right default: only a web build of the client, served
# from another origin, needs this. Native clients send no Origin header.
# "*" and malformed entries both stop the server at startup on purpose; see
# deploy/README.md for why deny-by-default matters even on a LAN.
# For a local `flutter run -d chrome` on port 8099:
#   SLIMM_CORS_ALLOWED_ORIGINS=http://localhost:8099
SLIMM_CORS_ALLOWED_ORIGINS=

# Most bytes the deployment will hold in attachments and custom emoji together.
# Unset means no ceiling. Past it an upload is refused with 507.
# SLIMM_MAX_TOTAL_ATTACHMENT_BYTES=2147483648

# How many reverse proxies sit in front of the server, for rate limiting.
# Default 0 keys on the TCP peer, which is right for a directly exposed server.
# SLIMM_TRUST_PROXY_HOPS=1

# How many Argon2id password hashes may run at once. Default 4. Each costs
# about 19 MiB while it runs, so this caps the memory a burst of logins can claim.
# SLIMM_HASH_CONCURRENCY=4

# Push relay base URL and the bearer key this deployment sends it. Set both or
# neither; unset means push notifications are off.
# SLIMM_PUSH_RELAY_URL=https://relay.example.com
# SLIMM_PUSH_RELAY_KEY=

# LiveKit SFU for voice and screen share. Set all three or none; unset means
# every voice route answers 501. The URL is the address clients can reach.
# SLIMM_LIVEKIT_URL=wss://livekit.example.com
# SLIMM_LIVEKIT_API_KEY=
# SLIMM_LIVEKIT_API_SECRET=
# Optional: reach LiveKit's room service on an internal address instead of the public one.
# SLIMM_LIVEKIT_SERVICE_URL=http://livekit:7880

# The owner/repo the Dock browses for modules, read from raw.githubusercontent.com
# only. Default Slim-m-org/slim-addons; the older NC1107/slim-addons is tried too.
# SLIMM_ADDONS_REPO=Slim-m-org/slim-addons

# Base URL of a Piston instance that runs code blocks. Unset means no Run button.
# SLIMM_CODE_RUNNER_URL=http://piston:2000

# Overrides the memory ceiling the server refuses new WebSocket connections
# near, in bytes. Default is the cgroup limit; with none, connections are always admitted.
# SLIMM_MEMORY_LIMIT_BYTES=536870912

# Build identifier /version reports, as 1 to 12 letters or digits. Read when the
# server is compiled, not at run time, so setting it on a running server does nothing.
# SLIMM_BUILD_ID=
