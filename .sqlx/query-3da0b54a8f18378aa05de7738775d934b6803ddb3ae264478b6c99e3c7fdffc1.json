{
  "db_name": "SQLite",
  "query": "SELECT c.id AS \"id!: ChannelId\", c.name AS \"name!\", c.kind AS \"kind!\", c.topic,\n                      c.position AS \"position!: i64\",\n                      c.parent_message_id AS \"parent_message_id: crate::ids::MessageId\",\n                      c.category_id AS \"category_id: crate::ids::ChannelCategoryId\",\n                      c.created_at AS \"created_at!\",\n                      c.slow_mode_seconds AS \"slow_mode_seconds!: i64\",\n                      c.join_muted AS \"join_muted!: bool\",\n                      c.default_notification AS \"default_notification!\",\n                      c.creates_rooms AS \"creates_rooms!: bool\",\n                      c.user_limit AS \"user_limit!: i64\",\n                      c.room_owner_id AS \"room_owner_id: crate::ids::UserId\",\n                      c.room_lobby_id AS \"room_lobby_id: ChannelId\",\n                      c.room_locked AS \"room_locked!: bool\"\n               FROM channels c\n               LEFT JOIN channel_categories cc ON cc.id = c.category_id\n               LEFT JOIN channel_categories cp ON cp.id = cc.parent_id\n               WHERE c.deleted_at IS NULL AND c.kind != 'dm' AND c.parent_message_id IS NULL\n               ORDER BY c.category_id IS NOT NULL,\n                        COALESCE(cp.position, cc.position), COALESCE(cp.created_at, cc.created_at),\n                        COALESCE(cp.id, cc.id), cc.parent_id IS NOT NULL,\n                        cc.position, cc.created_at, cc.id,\n                        c.position, c.created_at",
