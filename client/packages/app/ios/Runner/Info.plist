<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>slim-m</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>slimm</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Screen share on iOS is two processes. livekit_client reads
	     RTCScreenSharingExtension to know which extension to preselect in
	     RPSystemBroadcastPickerView, and flutter_webrtc reads
	     RTCAppGroupIdentifier to find the capture socket the extension
	     writes to. Both are read from this dictionary at runtime, and both
	     fail silently when absent: livekit's BroadcastManager.requestActivation
	     guards on the first and simply returns, which is exactly the "the
	     button does nothing" report this pair fixes. The names are the
	     packages' own; see BroadcastBundleInfo.swift and
	     FlutterBroadcastScreenCapturer.m. -->
	<key>RTCScreenSharingExtension</key>
	<string>top.npcserver.slimm.BroadcastExtension</string>
	<key>RTCAppGroupIdentifier</key>
	<string>group.top.npcserver.slimm</string>
	<!-- Declares that the app uses no encryption beyond what is exempt, which is
	     what stops App Store Connect asking the export compliance question on
	     every single build and holding it out of TestFlight until answered by
	     hand. Matches the same declaration check-in ships with on this account.
	     Revisit if the app ever adds encryption beyond transport security and
	     the push envelope. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Required whether or not the feature is reached: App Store review
	     rejects a binary whose linked SDKs reference these APIs without a
	     purpose string, and livekit_client and file_picker both do. -->
	<key>NSCameraUsageDescription</key>
	<string>slim-m uses the camera when you turn on video in a call.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>slim-m uses the microphone when you join a voice call.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>slim-m connects to a server on your local network if the space you join runs on one.</string>
	<!-- Only shown by iOS when the app-lock setting is on and Face ID is
	     the enrolled biometric; local_auth links Face ID's framework
	     regardless, so App Store review needs this string either way. -->
	<key>NSFaceIDUsageDescription</key>
	<string>slim-m uses Face ID to confirm it is you before opening the app, if you turn that on in Settings.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>slim-m opens your photo library when you attach an image to a message.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>slim-m saves an image to your photo library when you choose Save on it.</string>
	<!-- ITMS-90683 on build 82: a linked SDK referenced Core Location with no
	     purpose string. The reference came from DKImagePickerController, which
	     file_picker 11 pulled in and file_picker 12 no longer uses. The key
	     stays anyway: Apple wants a string for any referenced API, and whether
	     the reference is really gone cannot be confirmed without a macOS
	     archive. Nothing in slim-m calls a location API. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>slim-m never asks for your location. This entry exists because DKImagePickerController (an image-attachment picker) links against Core Location for photo EXIF geotag handling; we never request or transmit location data.</string>
	<!-- `audio` because a call records and plays audio while the app is in the
	     background. `voip` is absent on purpose: nothing constructs
	     VoipPushRegistrar, so declaring it is an App Store 2.5.4 rejection.
	     Calls the UI joins are still reported to CallKit by
	     VoiceCallReporter. remote-notification is the content-free wake.
	     docs/decisions/0057-ios-background-modes.md has what bringing voip
	     back needs. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Portrait only on iPhone. The layout is width-driven and a phone in
	     landscape reports ~932pt, which crosses into the two-pane medium
	     class and stretches a phone-sized shell across it. UIKit intersects
	     this array with FlutterViewController's permissive default, so this
	     key is the ceiling. The app is iPhone only (TARGETED_DEVICE_FAMILY 1), so
	     there is no iPad array. The hygiene workflow gates this. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>top.npcserver.slimm.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>slimm</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
