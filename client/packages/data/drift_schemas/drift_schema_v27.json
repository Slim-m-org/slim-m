  "fixed_sql": [
    {
      "name": "channels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"channels\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"topic\" TEXT NULL, \"cursor\" INTEGER NOT NULL DEFAULT 0, \"last_read_seq\" INTEGER NOT NULL DEFAULT 0, \"mentioned_seq\" INTEGER NOT NULL DEFAULT 0, \"manually_unread\" INTEGER NULL CHECK (\"manually_unread\" IN (0, 1)), \"is_personal_space\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_personal_space\" IN (0, 1)), \"dm_participant_id\" TEXT NULL, \"position\" INTEGER NOT NULL DEFAULT 0, \"op_cursor\" INTEGER NULL, \"parent_message_id\" TEXT NULL, \"category_id\" TEXT NULL, \"slow_mode_seconds\" INTEGER NOT NULL DEFAULT 0, \"join_muted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"join_muted\" IN (0, 1)), \"default_notification\" TEXT NULL, \"creates_rooms\" INTEGER NULL CHECK (\"creates_rooms\" IN (0, 1)), \"user_limit\" INTEGER NULL, \"room_owner_id\" TEXT NULL, \"room_locked\" INTEGER NULL CHECK (\"room_locked\" IN (0, 1)), \"restricted\" INTEGER NULL CHECK (\"restricted\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "messages",
      "sql": [
